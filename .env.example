# Development defaults only; change all passwords before sharing/exposing deployment.
AEGIS_ENV=development
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=replace-with-a-long-random-password
CLICKHOUSE_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=aegis-local
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
QDRANT_COLLECTION=aegis_knowledge
# Enable only after starting the streaming profile with docker compose --profile streaming up -d kafka
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=aegis.security.events

# Maximum accepted HTTP request body size (default: 10 MiB)
MAX_REQUEST_BYTES=10485760
